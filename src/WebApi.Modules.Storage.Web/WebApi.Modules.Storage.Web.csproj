<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Web: the module's entry assembly and composition root, the one the runtime loads. It holds the IRuntimeModule
    (StorageModule.cs), the service registration (Configurations/), and the HTTP endpoints, one file per resource
    (Items/, Uploads/, Access/, Groups/), mapped by StorageRoutes, the module's only ICarterModule.
    Endpoints call use cases through Mediator, never the Infrastructure layer.

    NOT referenced by WebApi: zip this project's build output (bin/<Configuration>/net10.0) and upload it on the Host
    Modules page, or let the playground load it. ModuleUsesData adds WebApi.Data and EF Core as compile-only
    references; EnableDynamicLoading writes the .deps.json the module loader resolves with.
  -->

  <PropertyGroup>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <ModuleUsesData>true</ModuleUsesData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="$(ArdalisResultVersion)" />
    <PackageReference Include="Mediator.Abstractions" Version="$(MediatorVersion)" />
    <!-- Generates the module's mediator (handler table, AddMediator) into this assembly at compile time. -->
    <PackageReference Include="Mediator.SourceGenerator" Version="$(MediatorVersion)" PrivateAssets="all"
                      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApi.Modules.Storage.UseCases\WebApi.Modules.Storage.UseCases.csproj" />
    <ProjectReference Include="..\WebApi.Modules.Storage.Infrastructure\WebApi.Modules.Storage.Infrastructure.csproj" />
  </ItemGroup>

</Project>
