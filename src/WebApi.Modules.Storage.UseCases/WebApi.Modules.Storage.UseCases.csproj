<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="soft.square.net.ModularBlazor.Module.Sdk" />

  <!--
    Use cases: one folder per resource (Items, Uploads, Access, Groups), each use case a Mediator command or query and
    its handler, returning an Ardalis Result. Also the module's permissions, settings, DTOs and the blob store
    abstraction (IBlobStore; the providers are in Infrastructure). References Core only.
    Mediator.Abstractions and Ardalis.Result are private: copied into the module's output, unloaded with it.
  -->

  <PropertyGroup>
    <ModuleLayer>Application</ModuleLayer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.Result" Version="$(ArdalisResultVersion)" />
    <PackageReference Include="Mediator.Abstractions" Version="$(MediatorVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApi.Modules.Storage.Core\WebApi.Modules.Storage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="soft.square.net.WebApi.Modules.Storage.UnitTests" />
  </ItemGroup>

</Project>
