{
  "openapi": "3.1.1",
  "info": {
    "title": "Storage",
    "description": "Folders and files with Windows-style access control lists, resumable uploads and signed download links.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/storage/roots": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "The navigation pane's starting points: Files and your home folder (created on first use).",
        "operationId": "Storage_GetRoots",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Roots"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/usage": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "The tenant's storage use: bytes kept, bytes of uploads under way, and the quota (null: none).",
        "operationId": "Storage_GetUsage",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageUsage"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/folders/{id}/items": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "Open a folder: its path and the items you have any right on, folders first (List folder).",
        "operationId": "Storage_ListFolder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FolderView"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "An item's properties, path and versions (Read attributes).",
        "operationId": "Storage_GetItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetail"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Storage"
        ],
        "summary": "Rename (Delete on the item, or Delete children on its folder).",
        "operationId": "Storage_RenameItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/folders": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "New folder (Create folders on the parent); numberIfTaken gives \"New folder (2)\".",
        "operationId": "Storage_CreateFolder",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFolderCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/move": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Cut and paste, or drag: move items into a folder; each item moves on its own.",
        "operationId": "Storage_MoveItems",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveItemsCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/copy": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Copy and paste: copies inherit from the destination; file copies share their blob.",
        "operationId": "Storage_CopyItems",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CopyItemsCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/delete": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Delete to the recycle bin; permanent: true removes them for good (Shift+Delete).",
        "operationId": "Storage_DeleteItems",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteItemsCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/recycle-bin": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "The recycle bin: what you deleted (Storage admins: everything deleted in the tenant), newest first.",
        "operationId": "Storage_GetRecycleBin",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeletedItemDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/recycle-bin/restore": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Restore items to their folders (a taken name gets a number); a deleted folder must be restored first.",
        "operationId": "Storage_RestoreItems",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestoreItemsCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/recycle-bin/purge": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Delete items in the recycle bin for good; no ids: empty the bin.",
        "operationId": "Storage_PurgeItems",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurgeItemsCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/versions/{number}/restore": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Make an earlier version current again, as a new version (Write data).",
        "operationId": "Storage_RestoreVersion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/versions/{number}": {
      "delete": {
        "tags": [
          "Storage"
        ],
        "summary": "Remove an earlier version (Write data); never the current one.",
        "operationId": "Storage_DeleteVersion",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/content": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "A file's bytes (Read data), the current version or another one; supports ranges.",
        "operationId": "Storage_DownloadFile",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "inline",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "$ref": "#/components/schemas/Stream"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/link": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "A short-lived URL to download or show a file without the access token (img, video, PDF viewer).",
        "operationId": "Storage_GetDownloadLink",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "inline",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadLink"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/uploads": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Start an upload into a folder (Create files). conflict: Fail, Replace or KeepBoth.",
        "operationId": "Storage_StartUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartUploadCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/uploads/{id}": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "Where an upload stands: send the chunk at 'received'.",
        "operationId": "Storage_GetUpload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Storage"
        ],
        "summary": "Cancel an upload and drop its bytes.",
        "operationId": "Storage_CancelUpload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/storage/uploads/{id}/chunks": {
      "put": {
        "tags": [
          "Storage"
        ],
        "summary": "One chunk of the file (form file \"chunk\"), at the offset the upload expects.",
        "operationId": "Storage_WriteChunk",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "chunk"
                ],
                "type": "object",
                "properties": {
                  "chunk": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/uploads/{id}/complete": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Finish an upload: the file appears in the folder (or becomes a new version with Replace).",
        "operationId": "Storage_CompleteUpload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/acl": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "An item's owner and access list: its own entries, then the inherited ones (Read permissions).",
        "operationId": "Storage_GetAcl",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AclDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Storage"
        ],
        "summary": "Set an item's own entries and inheritance (Change permissions).",
        "operationId": "Storage_SetAcl",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetAclRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AclDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/owner": {
      "put": {
        "tags": [
          "Storage"
        ],
        "summary": "Take ownership (no owner id; Take ownership), or give it to someone (Storage admins).",
        "operationId": "Storage_SetOwner",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetOwnerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AclDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/items/{id}/effective-access": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "What a member may do with the item, through their entries, groups and grants (Read permissions).",
        "operationId": "Storage_GetEffectiveAccess",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EffectiveAccessDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/groups": {
      "get": {
        "tags": [
          "Storage"
        ],
        "summary": "Every Storage group (the principal picker).",
        "operationId": "Storage_ListGroups",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GroupDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Create a Storage group.",
        "operationId": "Storage_CreateGroup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/storage/groups/{id}": {
      "put": {
        "tags": [
          "Storage"
        ],
        "summary": "Rename a group or change its members (version: the one you read).",
        "operationId": "Storage_UpdateGroup",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GroupInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GroupDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Storage"
        ],
        "summary": "Delete a group; entries that name it match nobody.",
        "operationId": "Storage_DeleteGroup",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/storage/maintenance/sweep": {
      "post": {
        "tags": [
          "Storage"
        ],
        "summary": "Sweep the tenant now: purge what stayed in the recycle bin too long, abort expired uploads, delete unused blobs.",
        "operationId": "Storage_Sweep",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SweepResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AceDto": {
        "required": [
          "principalKind",
          "principalId",
          "principalScope",
          "type",
          "rights",
          "inheritance",
          "inherited",
          "inheritedFromId",
          "inheritedFromName"
        ],
        "type": "object",
        "properties": {
          "principalKind": {
            "$ref": "#/components/schemas/PrincipalKind"
          },
          "principalId": {
            "type": [
              "null",
              "string"
            ]
          },
          "principalScope": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "$ref": "#/components/schemas/AceType"
          },
          "rights": {
            "type": "integer",
            "format": "int32"
          },
          "inheritance": {
            "type": "integer",
            "format": "int32"
